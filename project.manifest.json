{
  "packages": [
    {
      "directory": "sdk",
      "name": "@daqian/template-sdk",
      "role": "product",
      "form": "sdk",
      "private": false,
      "allowedDirectories": ["src", "dist", "node_modules"],
      "moduleRoots": ["src"],
      "consumedOperations": ["packages/sdk/src/consumed-operations.ts"]
    },
    {
      "directory": "protocol",
      "name": "@daqian/template-protocol",
      "role": "protocol",
      "protocolKind": "idl",
      "checks": ["proto:validate", "proto:status"],
      "private": false,
      "allowedDirectories": ["src", "testing", "dist", "node_modules"],
      "moduleRoots": ["src", "testing"]
    },
    {
      "directory": "openapi",
      "name": "@daqian/template-openapi",
      "role": "protocol",
      "protocolKind": "openapi",
      "checks": ["api:validate", "api:status"],
      "private": false,
      "allowedDirectories": ["src", "testing", "contracts", "dist", "node_modules"],
      "moduleRoots": ["src", "testing"],
      "contract": {
        "file": "packages/openapi/contracts/trade-v1.yaml",
        "lock": "packages/openapi/contracts/trade-v1.lock.json"
      }
    },
    {
      "directory": "web",
      "name": "@daqian/template-web",
      "role": "product",
      "form": "web-app",
      "private": true,
      "allowedDirectories": ["src", "dist", "node_modules"],
      "moduleRoots": ["src"],
      "globalStore": "src/store/index.ts",
      "consumedOperations": ["packages/web/src/app/consumed-operations.ts"]
    },
    {
      "directory": "e2e",
      "name": "@daqian/template-e2e",
      "role": "test",
      "private": true,
      "allowedDirectories": ["src", "host", "tests", "node_modules"],
      "moduleRoots": ["src", "host", "tests"]
    }
  ],
  "bindings": [
    {
      "name": "sdk-idl-weapp",
      "product": "sdk",
      "protocol": "protocol",
      "platforms": ["weapp"]
    },
    {
      "name": "web-openapi-browser",
      "product": "web",
      "protocol": "openapi",
      "platforms": []
    }
  ],
  "requiredCommands": [
    "proto:version",
    "proto:validate",
    "proto:status",
    "proto:sync",
    "api:validate",
    "api:sync",
    "api:status",
    "lint",
    "typecheck",
    "build",
    "format",
    "format:check",
    "test:unit",
    "test:integration",
    "test:affected",
    "test:e2e:weapp",
    "check:architecture",
    "check:coverage",
    "check:fixtures",
    "fixtures:refresh",
    "check:scenarios",
    "check:package",
    "check:bundle",
    "check:component-tree",
    "check:fast",
    "weapp:prepare",
    "verify",
    "check",
    "check:project-map"
  ],
  "testProjects": [
    {
      "name": "sdk-unit",
      "class": "unit",
      "config": "packages/sdk/vitest.config.ts"
    },
    {
      "name": "protocol-unit",
      "class": "unit",
      "config": "packages/protocol/vitest.config.ts"
    },
    {
      "name": "openapi-unit",
      "class": "unit",
      "config": "packages/openapi/vitest.config.ts"
    },
    {
      "name": "app-unit",
      "class": "unit",
      "config": "packages/web/vitest.config.ts"
    },
    {
      "name": "test-tools-unit",
      "class": "unit",
      "config": "packages/e2e/vitest.config.unit.ts"
    },
    {
      "name": "integration",
      "class": "integration",
      "config": "packages/e2e/vitest.config.integration.ts"
    },
    {
      "name": "weapp",
      "class": "platform",
      "config": "packages/e2e/vitest.config.weapp.ts",
      "perFile": true,
      "prepare": "weapp:prepare"
    }
  ],
  "fingerprints": {
    "sourceRoots": [
      "packages/sdk/src",
      "packages/protocol/src",
      "packages/protocol/testing",
      "packages/openapi/src",
      "packages/openapi/testing",
      "packages/web/src",
      "packages/e2e/src",
      "packages/e2e/host",
      "packages/e2e/tests",
      "scripts"
    ],
    "buildInputs": [
      "package.json",
      "pnpm-lock.yaml",
      "tsconfig*.json",
      "vitest.config.ts",
      "vitest.shared.ts",
      ".dependency-cruiser.cjs",
      "eslint.config.js",
      ".prettierrc.json",
      ".prettierignore",
      "packages/*/package.json",
      "packages/*/tsconfig*.json",
      "packages/*/vite.config.ts",
      "packages/*/vitest.config*.ts"
    ],
    "protocolInputs": [
      "proto-gen.lock",
      "packages/openapi/contracts/trade-v1.yaml",
      "packages/openapi/contracts/trade-v1.lock.json"
    ]
  },
  "quality": {
    "coverageExclusions": [
      {
        "path": "packages/e2e/host/weapp/setup.ts",
        "reason": "只在微信开发者工具宿主中执行，行为证据由 weapp 用例承担"
      },
      {
        "path": "packages/e2e/host/weapp/vite.config.ts",
        "reason": "只在微信开发者工具宿主中执行，行为证据由 weapp 用例承担"
      },
      {
        "path": "packages/e2e/host/weapp/protocol-runner.ts",
        "reason": "只在微信开发者工具宿主中执行，行为证据由 weapp 用例承担"
      },
      {
        "path": "packages/e2e/host/weapp/example-runner.ts",
        "reason": "只在微信开发者工具宿主中执行，行为证据由 weapp 用例承担"
      }
    ],
    "maxLinesExemptions": [],
    "componentNameExemptions": []
  },
  "release": {
    "registry": "https://gitlab.daqian369.com/api/v4/projects/<PROJECT_ID>/packages/npm/",
    "tagPrefix": "template-sdk-v"
  }
}
