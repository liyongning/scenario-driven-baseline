{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM"],
    "types": ["node", "vitest/globals"],
    "paths": {
      "@daqian/template-protocol": ["packages/protocol/src/index.ts"],
      "@daqian/template-openapi": ["packages/openapi/src/index.ts"],
      "@daqian/template-sdk": ["packages/sdk/src/index.ts"],
      "@template-test/protocol": ["packages/protocol/testing/index.ts"],
      "@template-test/shadow": ["packages/e2e/src/shadow/index.ts"]
    }
  },
  "include": ["packages/**/*.ts"],
  "exclude": ["packages/**/dist", "packages/**/src/generated"]
}
