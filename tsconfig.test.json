{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@daqian/payment-protocol": [
        "packages/payment-protocol/src/index.ts"
      ],
      "@daqian/payment-sdk": [
        "packages/payment-sdk/src/index.ts"
      ],
      "@payment-test/protocol": [
        "packages/payment-protocol/testing/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts"
  ],
  "exclude": [
    "packages/**/dist",
    "packages/**/src/generated"
  ]
}
