# 本示例只登记宿主消费的非敏感 key（登记处见 Design 的 .env.live 配置清单）。
# 本机 .env.live 可以包含其它 key：只有已登记的会被宿主读取，未登记的不进入宿主配置、也不影响已登记配置。
# 凭据类 key（名称含 TOKEN、SECRET、SESSION_KEY、SIGNATURE、PASSWORD 等或 VITE_ 前缀）会被宿主校验拒绝；不得提交真实凭据，Token 只由控制台确认写入 Storage。
PAYMENT_LIVE_GATEWAY_BASE_URL=
PAYMENT_LIVE_CREATE_TRADE_URL=
PAYMENT_LIVE_PRODUCT_ID=
PAYMENT_LIVE_LANE=
PAYMENT_LIVE_APP_VERSION=
PAYMENT_LIVE_SERVER_ENV=test
# 可选：创建表单 user_id 初始值；须为与 Token 同一测试账号的正整数 uid，留空则页面手填。
PAYMENT_LIVE_USER_ID=
LIVE_EXAMPLE_KIND=
LIVE_EXAMPLE_ITEM_ID=
LIVE_EXAMPLE_ITEM_NAME=
LIVE_EXAMPLE_UNIT_VALUE=
# 可选：仅允许 bizType、goodsType、items 和三项整单金额；user_id 单独由 PAYMENT_LIVE_USER_ID 配置，不得放 Token 或业务单号。
# skuSnapshot 必须是结构化对象；bizSnapshot 仍是 JSON 字符串。
# 渠道策略要求 Live 交易最低 100 分；默认示例也使用 100。
# PAYMENT_LIVE_TRADE_DEFAULTS_JSON={"bizType":"payment_sdk_live","goodsType":"GOODS_TYPE_VIRTUAL","items":[{"skuId":"sdk-live-test-sku","skuName":"支付 SDK 联调商品","skuSnapshot":{"wechatVirtualProductId":"sdk-live-test-sku","bizSnapshot":"{}"},"quantity":"1","unitPrice":"100","discountAmount":"0","payAmount":"100"}],"originalAmount":"100","discountAmount":"0","payAmount":"100"}
