{
  "name": "sdk-template",
  "version": "0.0.0",
  "private": true,
  "description": "SDK 领域项目模板：示例、质量门禁与工程工具链",
  "scripts": {
    "proto:version": "proto-gen version --json",
    "proto:validate": "proto-gen config validate --json",
    "proto:status": "proto-gen consumer status --branch feat/esm-v1.4 --json",
    "proto:sync": "proto-gen consumer sync --branch feat/esm-v1.4 --json",
    "typecheck": "tsc -p packages/protocol/tsconfig.build.json --noEmit && tsc -p packages/sdk/tsconfig.build.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "build": "pnpm --filter @daqian/template-protocol build && pnpm --filter @daqian/template-sdk build",
    "test:unit": "PAYMENT_REPORT_FILE=artifacts/${PAYMENT_RUN_ID:-local}/reports/unit.json vitest run --project sdk-unit --project protocol-unit --project test-tools-unit --coverage",
    "test:integration": "PAYMENT_REPORT_FILE=artifacts/${PAYMENT_RUN_ID:-local}/reports/integration.json vitest run --project integration",
    "test:e2e:weapp": "PAYMENT_REPORT_FILE=artifacts/${PAYMENT_RUN_ID:-local}/reports/weapp.json vitest run --project weapp",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs --output-type err-long packages/sdk/src packages/protocol/src packages/protocol/testing && tsx scripts/check-architecture.ts",
    "check:fixtures": "tsx scripts/check-fixtures.ts",
    "check:scenarios": "tsx scripts/check-scenarios.ts",
    "check:package": "tsx scripts/check-package.ts",
    "release:preflight": "tsx scripts/check-release.ts",
    "sdk-release": "tsx scripts/sdk-release.ts",
    "check:fast": "pnpm proto:validate && pnpm proto:status && pnpm lint && pnpm build && pnpm typecheck && pnpm check:architecture && pnpm test:unit && pnpm check:fixtures && pnpm test:integration && pnpm check:package",
    "check": "pnpm check:fast && pnpm test:e2e:weapp && pnpm check:scenarios"
  },
  "packageManager": "pnpm@10.20.0",
  "type": "module",
  "devDependencies": {
    "@daqian/proto-gen": "0.1.2",
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.59.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "5.0.0",
    "ajv": "8.20.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.10.0",
    "express": "5.2.1",
    "globals": "17.12.0",
    "miniprogram-automator": "0.12.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "unplugin-dts": "1.1.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
