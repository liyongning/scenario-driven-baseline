{
  "name": "sdk-template",
  "version": "0.0.0",
  "private": true,
  "description": "SDK 领域项目模板：示例、质量门禁与工程工具链",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "proto:version": "proto-gen version --json",
    "proto:validate": "proto-gen config validate --json",
    "proto:status": "proto-gen consumer status --branch feat/esm-v1.4 --json",
    "proto:sync": "proto-gen consumer sync --branch feat/esm-v1.4 --json",
    "api:validate": "tsx scripts/api-contract.ts validate",
    "api:sync": "tsx scripts/api-contract.ts sync",
    "api:status": "tsx scripts/api-contract.ts status",
    "typecheck": "tsx scripts/run-by-manifest.ts typecheck",
    "lint": "eslint .",
    "build": "tsx scripts/run-by-manifest.ts build",
    "test:unit": "tsx scripts/run-by-manifest.ts test:unit",
    "test:integration": "tsx scripts/run-by-manifest.ts test:integration",
    "test:affected": "tsx scripts/test-affected.ts",
    "test:e2e:weapp": "tsx scripts/run-by-manifest.ts test:e2e:weapp",
    "test:e2e:browser": "tsx scripts/run-by-manifest.ts test:e2e:browser",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:project-map": "tsx scripts/check-project-map.ts",
    "check:coverage": "tsx scripts/check-coverage.ts",
    "check:fixtures": "tsx scripts/check-fixtures.ts",
    "fixtures:refresh": "tsx scripts/fixtures-refresh.ts",
    "check:scenarios": "tsx scripts/check-scenarios.ts",
    "check:package": "tsx scripts/check-package.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:component-tree": "tsx scripts/check-component-tree.ts",
    "release:preflight": "tsx scripts/check-release.ts",
    "sdk-release": "tsx scripts/sdk-release.ts",
    "check:fast": "tsx scripts/run-by-manifest.ts check:fast",
    "weapp:prepare": "tsx scripts/weapp-prepare.ts",
    "verify": "tsx scripts/verify.ts",
    "check": "pnpm verify"
  },
  "packageManager": "pnpm@10.20.0",
  "type": "module",
  "devDependencies": {
    "@daqian/proto-gen": "0.1.3",
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.6.0",
    "@microsoft/api-extractor": "7.59.4",
    "@redocly/cli": "2.62.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "express": "5.2.1",
    "globals": "17.13.0",
    "miniprogram-automator": "0.12.1",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "unplugin-dts": "1.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
