{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daqian.example/payment-verification.schema.json",
  "type": "object",
  "required": ["formatVersion", "checkpoints", "cases", "blockedBy"],
  "properties": {
    "formatVersion": { "const": 2 },
    "checkpoints": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "kind", "requiredIn", "checks"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "kind": { "enum": ["behavior", "module", "engineering"] },
          "requiredIn": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "enum": ["sdk-unit", "protocol-unit", "test-tools-unit", "integration", "weapp"] }
          },
          "checks": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string" }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "behavior" } }, "required": ["kind"] },
            "then": { "properties": { "requiredIn": { "type": "array", "items": { "enum": ["integration", "weapp"] } } } }
          },
          {
            "if": { "properties": { "kind": { "const": "module" } }, "required": ["kind"] },
            "then": { "properties": { "requiredIn": { "type": "array", "items": { "enum": ["sdk-unit", "protocol-unit", "test-tools-unit"] } } } }
          },
          {
            "if": { "properties": { "kind": { "const": "engineering" } }, "required": ["kind"] },
            "then": { "properties": { "requiredIn": { "type": "array", "items": { "const": "integration" } } } }
          }
        ],
        "additionalProperties": false
      }
    },
    "blockedBy": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^SDK-P-" } }
  },
  "additionalProperties": false
}
