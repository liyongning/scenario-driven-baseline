{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daqian.example/dataset.schema.json",
  "type": "object",
  "required": ["formatVersion", "protocol", "entries"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": 1,
      "description": "预览数据集格式版本。"
    },
    "protocol": {
      "description": "预览数据集响应所属协议包目录。",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "description": "数据集用途的可读说明。",
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "description": "按接口登记的一组预览响应。",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operationId", "responses"],
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "description": "协议包能够解析的接口标识。",
            "type": "string",
            "minLength": 1
          },
          "pathParams": {
            "description": "路径参数精确匹配值；缺省表示匹配任意路径参数。",
            "type": "object",
            "additionalProperties": {
              "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
            }
          },
          "responses": {
            "description": "供预览使用的响应序列，status 缺省为 200。",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["body"],
              "additionalProperties": false,
              "properties": {
                "status": {
                  "description": "响应的 HTTP 状态码；缺省为 200。",
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                "body": {
                  "description": "按协议响应结构严格校验的响应体。"
                }
              }
            }
          }
        }
      }
    }
  }
}
