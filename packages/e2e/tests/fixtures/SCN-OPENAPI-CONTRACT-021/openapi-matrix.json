{
  "envelopes": {
    "$.plans.createTrade.responses[0]": "createTrade",
    "$.plans.getTrade.responses[0]": "getTrade",
    "$.plans.listTrades.responses[0]": "listTrades"
  },
  "plans": {
    "createTrade": {
      "input": { "body": { "merchant_id": 1001, "amount": 1, "channel": "WEB" } },
      "responses": [
        { "code": 0, "message": "ok", "data": { "trade_no": "T-1", "status": "CREATED", "amount": 1, "merchant_id": 1001 } }
      ]
    },
    "getTrade": {
      "input": { "path": { "trade_no": "T-1" } },
      "responses": [
        { "code": 0, "message": "ok", "data": { "trade_no": "T-1", "status": "CREATED", "amount": 1, "merchant_id": 1001 } }
      ]
    },
    "listTrades": {
      "input": { "path": { "merchant_id": 1001 } },
      "responses": [
        { "code": 0, "message": "ok", "data": { "items": [ { "trade_no": "T-1", "status": "CREATED", "amount": 1, "merchant_id": 1001 } ] } }
      ]
    }
  }
}
