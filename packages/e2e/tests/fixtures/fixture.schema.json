{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daqian.example/fixture.schema.json",
  "type": "object",
  "required": [
    "formatVersion",
    "ownerId",
    "sources",
    "cases",
    "sha256"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "ownerId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*$",
      "description": "ownerId 的基础形态；项目允许的具体格式由 scenario-gate.config.json 校验。"
    },
    "protocol": {
      "description": "该 Fixture 的协议响应所属协议包目录；包含协议响应时必须声明。",
      "type": "string",
      "minLength": 1
    },
    "contractCarrier": {
      "description": "Fixture 使用的契约载体；缺省为 product。",
      "enum": ["product", "engine"]
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "spec"
      ],
      "properties": {
        "spec": {
          "type": "object",
          "required": [
            "requirementDigest"
          ],
          "properties": {
            "requirementDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "所属 Requirement 块规范化文本（LF、去行尾空白、去空行）的 sha256；不再记录 Spec 路径。"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "cases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[^/]+\\.json$"
      }
    },
    "sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "additionalProperties": true
}
