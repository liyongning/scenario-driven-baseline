{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["manifest", "events", "matrix", "review"],
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "type": "object",
      "required": ["mode", "runId", "executedAt", "sourceDigest", "specDigest", "idlDigest", "createContractDigest", "sdkVersion", "protocolVersion", "bundleHash", "configHash", "buildManifestHash", "executions", "authorization"],
      "properties": {
        "mode": { "const": "live" },
        "runId": { "type": "string", "minLength": 1 },
        "executedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+Z$" },
        "sourceDigest": { "$ref": "#/$defs/hash" },
        "specDigest": { "$ref": "#/$defs/hash" },
        "idlDigest": { "$ref": "#/$defs/hash" },
        "createContractDigest": { "$ref": "#/$defs/hash" },
        "sdkVersion": { "type": "string", "minLength": 1 },
        "protocolVersion": { "type": "string", "minLength": 1 },
        "bundleHash": { "$ref": "#/$defs/hash" },
        "configHash": { "$ref": "#/$defs/hash" },
        "buildManifestHash": { "$ref": "#/$defs/hash" },
        "executions": { "type": "array", "minItems": 9, "items": { "oneOf": [{ "$ref": "#/$defs/deviceExecution" }, { "$ref": "#/$defs/serviceExecution" }] } },
        "authorization": {
          "type": "object",
          "required": ["scope", "reviewer"],
          "properties": {
            "scope": { "type": "string", "minLength": 1 },
            "reviewer": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/tradeCreatedEvent" },
          { "$ref": "#/$defs/phaseEvent" },
          { "$ref": "#/$defs/outcomeEvent" },
          { "$ref": "#/$defs/queryEvent" },
          { "$ref": "#/$defs/queryErrorEvent" }
        ]
      }
    },
    "matrix": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/matrixEntry" }
    },
    "review": {
      "type": "object",
      "required": ["verdict", "reviewer"],
      "properties": {
        "verdict": { "const": "PASS" },
        "reviewer": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baseEvent": {
      "type": "object",
      "required": ["sequence", "atMs", "executionId", "correlationId", "kind"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "atMs": { "type": "number", "minimum": 0 },
        "executionId": { "type": "string", "minLength": 1 },
        "correlationId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" }
      }
    },
    "tradeCreatedEvent": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        { "type": "object", "properties": { "kind": { "const": "trade_created" } } }
      ]
    },
    "device": {
      "type": "object",
      "required": ["platform", "model", "osVersion", "wechatVersion", "baseLibraryVersion"],
      "properties": {
        "platform": { "enum": ["android", "ios"] },
        "model": { "type": "string", "minLength": 1 },
        "osVersion": { "type": "string", "minLength": 1 },
        "wechatVersion": { "type": "string", "minLength": 1 },
        "baseLibraryVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "required": ["serverEnv", "gatewayBuild", "tradeBuild", "payBuild"],
      "properties": {
        "serverEnv": { "enum": ["test", "prod"] },
        "gatewayBuild": { "type": "string", "minLength": 1 },
        "tradeBuild": { "type": "string", "minLength": 1 },
        "payBuild": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "deviceExecution": {
      "type": "object",
      "required": ["id", "kind", "executedAt", "xpayEnv", "device", "services"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "device" },
        "executedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+Z$" },
        "xpayEnv": { "enum": ["omitted", "sandbox", "prod"] },
        "device": { "$ref": "#/$defs/device" },
        "services": { "$ref": "#/$defs/services" }
      },
      "additionalProperties": false
    },
    "serviceExecution": {
      "type": "object",
      "required": ["id", "kind", "executedAt", "xpayEnv", "services"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "service" },
        "executedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+Z$" },
        "xpayEnv": { "enum": ["omitted", "sandbox", "prod"] },
        "services": { "$ref": "#/$defs/services" }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": ["state", "source"],
      "properties": {
        "state": { "enum": ["CREATED", "PAYING", "PAID", "CLOSED", "UNKNOWN"] },
        "source": { "enum": ["server", "unavailable"] }
      },
      "additionalProperties": false
    },
    "phaseEvent": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "required": ["attemptId", "phase"],
          "properties": {
            "kind": { "const": "phase" },
            "attemptId": { "type": "string", "minLength": 1 },
            "phase": { "enum": ["channel_invoking", "confirming"] }
          }
        }
      ]
    },
    "outcomeEvent": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "required": ["attemptId", "snapshot", "channelSignal", "reason"],
          "properties": {
            "kind": { "const": "outcome" },
            "attemptId": { "type": "string", "minLength": 1 },
            "snapshot": { "$ref": "#/$defs/snapshot" },
            "channelSignal": { "enum": ["not_invoked", "success_hint", "cancelled", "launch_failed", "unknown"] },
            "reason": { "enum": ["confirmed", "channel_cancelled", "launch_failed", "auth_required", "identity_required", "channel_session_required", "unsupported", "busy", "timed_out", "stopped", "error", "action_required"] },
            "interruptedPhase": { "enum": ["prepare", "invoke", "query"] },
            "errorCode": { "$ref": "#/$defs/errorCode" },
            "errorSource": { "$ref": "#/$defs/errorSource" }
          }
        }
      ]
    },
    "queryEvent": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "required": ["snapshot"],
          "properties": { "kind": { "const": "query" }, "snapshot": { "$ref": "#/$defs/snapshot" } }
        }
      ]
    },
    "queryErrorEvent": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "required": ["errorCode", "errorSource"],
          "properties": {
            "kind": { "const": "query_error" },
            "errorCode": { "$ref": "#/$defs/errorCode" },
            "errorSource": { "$ref": "#/$defs/errorSource" }
          }
        }
      ]
    },
    "errorCode": { "enum": ["AUTH_REQUIRED", "IDENTITY_REQUIRED", "CHANNEL_SESSION_REQUIRED", "UNSUPPORTED", "BUSY", "INVALID_INPUT", "HOST_CONTEXT_ERROR", "NETWORK_ERROR", "PROTOCOL_ERROR", "CHANNEL_ERROR", "SERVER_ERROR", "CONFLICT", "TIMEOUT"] },
    "errorSource": { "enum": ["sdk", "host", "network", "gateway", "channel"] },
    "attachment": {
      "type": "object",
      "required": ["path", "sha256", "mode", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "mode": { "const": "live" },
        "kind": { "enum": ["live-host-record", "live-service-record", "visual-proof"] }
      },
      "additionalProperties": false
    },
    "matrixEntry": {
      "type": "object",
      "required": ["id", "caseKey", "status", "executionId", "attachments"],
      "properties": {
        "id": { "enum": ["LIVE-PAYSDK-001", "LIVE-PAYSDK-002"] },
        "caseKey": { "type": "string", "minLength": 1 },
        "status": { "const": "passed" },
        "executionId": { "type": "string", "minLength": 1 },
        "attachments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/attachment" } }
      },
      "additionalProperties": false
    }
  }
}
