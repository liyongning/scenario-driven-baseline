{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "mode", "controlledToolInput", "createTradeAdapter", "createTradeBinding", "createContractDigest", "configKeys", "configHash", "projectHash", "sourceDigest", "specDigest", "idlDigest", "sourceFiles", "moduleGraph", "products", "productionEntrypoints", "outputFiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "const": "live" },
    "controlledToolInput": { "type": "boolean" },
    "createTradeAdapter": { "const": "protocol-generated" },
    "createTradeBinding": {
      "type": "object",
      "required": ["method", "path"],
      "properties": { "method": { "const": "POST" }, "path": { "const": "/api/base/trade/create" } },
      "additionalProperties": false
    },
    "createContractDigest": { "$ref": "#/$defs/hash" },
    "configKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "configHash": { "$ref": "#/$defs/hash" },
    "projectHash": { "$ref": "#/$defs/hash" },
    "sourceDigest": { "$ref": "#/$defs/hash" },
    "specDigest": { "$ref": "#/$defs/hash" },
    "idlDigest": { "$ref": "#/$defs/hash" },
    "sourceFiles": { "$ref": "#/$defs/fileHashes" },
    "moduleGraph": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "products": {
      "type": "object",
      "required": ["sdk", "protocol"],
      "properties": {
        "sdk": { "$ref": "#/$defs/product" },
        "protocol": { "$ref": "#/$defs/product" }
      },
      "additionalProperties": false
    },
    "productionEntrypoints": {
      "type": "array",
      "const": ["@daqian/payment-sdk", "@daqian/payment-protocol"]
    },
    "outputFiles": { "$ref": "#/$defs/fileHashes" }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fileHashes": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": { "^.+$": { "$ref": "#/$defs/hash" } },
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "required": ["version", "files"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "files": { "$ref": "#/$defs/fileHashes" }
      },
      "additionalProperties": false
    }
  }
}
