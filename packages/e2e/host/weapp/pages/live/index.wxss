.page { padding: 32rpx; }
.warning { color: #b42318; margin-bottom: 24rpx; }
button, input, radio-group, view, text { margin-bottom: 16rpx; }
text { display: block; white-space: pre-wrap; word-break: break-all; }
.item { padding: 16rpx; border: 1rpx solid #d0d5dd; }
.section-title { margin-top: 32rpx; font-size: 32rpx; font-weight: 600; }
.item-title { font-weight: 600; }
.field-label { margin-bottom: 4rpx; color: #475467; font-size: 24rpx; }
input { box-sizing: border-box; width: 100%; min-height: 72rpx; padding: 12rpx 16rpx; border: 1rpx solid #d0d5dd; border-radius: 8rpx; }
radio-group { display: flex; gap: 24rpx; }
