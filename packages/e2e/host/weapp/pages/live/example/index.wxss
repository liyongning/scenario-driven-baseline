.page { padding: 32rpx; color: #20272a; background: #f7f8f8; min-height: 100vh; box-sizing: border-box; }
.heading { font-size: 36rpx; font-weight: 600; margin-bottom: 16rpx; }
.context, .status { color: #53616a; margin-bottom: 24rpx; }
.section-title { font-size: 28rpx; font-weight: 600; margin-top: 32rpx; margin-bottom: 16rpx; }
.field-label { font-size: 24rpx; color: #53616a; margin-bottom: 8rpx; }
input { box-sizing: border-box; width: 100%; min-height: 76rpx; padding: 12rpx 16rpx; margin-bottom: 18rpx; border: 1rpx solid #cfd7d9; border-radius: 8rpx; background: white; }
button { border-radius: 8rpx; margin-top: 16rpx; }
.actions { display: flex; gap: 12rpx; }
.actions button { flex: 1; margin: 0; }
.primary { background: #147d6f; color: white; }
.result { margin: 28rpx 0; padding: 20rpx; border: 1rpx solid #cfd7d9; background: white; }
.result text { display: block; white-space: pre-wrap; word-break: break-all; margin-top: 12rpx; }
