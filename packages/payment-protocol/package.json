{
  "name": "@daqian/payment-protocol",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./generated/*": {
      "import": {
        "types": "./dist/generated/*.d.ts",
        "default": "./dist/generated/*.js"
      },
      "require": {
        "types": "./dist/generated/*.d.cts",
        "default": "./dist/generated/*.cjs"
      }
    }
  },
  "scripts": {
    "build": "vite build"
  },
  "publishConfig": {
    "registry": "https://gitlab.daqian369.com/api/v4/projects/245/packages/npm/"
  }
}
